{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "70rem",
			"wideSize": "88rem"
		},
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "accent", "color": "#356ae6", "name": "Accent" },
				{ "slug": "ink", "color": "#17202b", "name": "Ink" },
				{ "slug": "muted", "color": "#586474", "name": "Muted" },
				{ "slug": "surface", "color": "#ffffff", "name": "Surface" }
			]
		},
		"spacing": { "blockGap": true, "units": [ "px", "rem", "em", "%", "vw" ] },
		"typography": {
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"slug": "system",
					"name": "System sans"
				}
			]
		}
	},
	"styles": {
		"color": { "background": "#f7f8fa", "text": "#17202b" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--system)", "lineHeight": "1.65" }
	}
}
